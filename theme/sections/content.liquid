{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% if collection.metafields.custom.show_collection_content == true %}
  <section class="content-section section-{{ section.id }}-padding">
    <div class="page-width">
        <div class="content-section-inner">
      {% if section.settings.main_heading and section.settings.intro_description != '' %}
        <div class="content-wrapper" style="text-align: {{ section.settings.box_alignment }};">
          <!-- Main Heading -->
          <h2 class="main-heading">
            {{ section.settings.main_heading }}
          </h2>

          <!-- Intro Description -->
          <div class="intro-text">
            {{ section.settings.intro_description }}
          </div>
        </div>
      {% endif %}

      <!-- Dynamic Content Blocks -->
      <div class="content-section-wapper">
        {% for block in section.blocks %}
          <h2 class="blok-title">
            {{ block.settings.block_title }}
          </h2>
          <div class="block-description">
            {{ block.settings.block_description }}
          </div>
        {% endfor %}
      </div>
      </div>
      </div>
  </section>
{% endif %}

<style>
  .content-section-inner {
    margin: 0 auto;
    box-shadow: 5px 5px 15px 5px rgba(0, 0, 0, 0.32);
  }

  .blok-title {
    font-weight: 500;
    margin-top: 0;
    margin-bottom: 0;
  }
  .block-description p {
    margin-bottom: 0;
  }

  /* Desktop & Tablet */
  @media (min-width: 750px) {
    .content-section-inner {
    padding: 40px;
    border-radius: 10px;
  }
    .blok-title:not(:first-child) {
      margin-top: 2rem;
    }
    .block-description p {
      margin-top: 2rem;
    }
  }

  /* Mobile */
  @media (max-width: 749px) {
    .content-section-inner {
    padding: 20px;
    border-radius: 8px;
  }
  .blok-title {
    font-size: 1.8rem;
}
    .blok-title:not(:first-child) {
      margin-top: 1.6rem;
    }
    .block-description p {
      margin-top: 1.6rem;
    }
  }
</style>

{% schema %}
{
  "name": "Content Section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "main_heading",
      "label": "Main Heading"
    },
    {
      "type": "richtext",
      "id": "intro_description",
      "label": "Main Description"
    },
    {
      "type": "select",
      "id": "box_alignment",
      "label": "Box Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "content_block",
      "name": "Content Block",
      "settings": [
        {
          "type": "text",
          "id": "block_title",
          "label": "Block Title"
        },
        {
          "type": "richtext",
          "id": "block_description",
          "label": "Block Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Content Section"
    }
  ]
}
{% endschema %}
